# Copy to .env (git-ignored) and fill in your prod.
# Values are taken literally (no $VAR expansion). Quote a value that contains
# " #" or leading/trailing spaces: PROD_PASSWORD="my #pass". Passwords must not
# contain a double quote (").

# --- Prod -------------------------------------------------------------------
PROD_CONNECT=db.example.com:1521/ORCLPDB1   # host:port/service of prod
PROD_USER=app
PROD_PASSWORD=change_me
APP_SCHEMA=APP                  # schema that owns the packages
ORACLE_VERSION=19               # prod version: 11 | 12 | 18 | 19 | 21 | 23
# PROD_TNS=PRODDB               # instead of PROD_CONNECT: a TNS alias ...
# TNS_ADMIN=/absolute/path      # ... and the folder with tnsnames.ora

# --- Local database ---------------------------------------------------------
LOCAL_SYS_PASSWORD=local_pw1    # local DB password (SYSTEM and APP_SCHEMA, e.g. in DBeaver)
LOCAL_PORT=1530                 # host port of the local DB
# LOCAL_DB_MEMORY_MB=1024       # memory for the local DB (min 768)

# --- Optional ---------------------------------------------------------------
# DATA_SCOPE=config/data-scope.conf   # which rows `make sync` copies
# SYNC_MODE=auto                      # auto (Data Pump, falls back to copy) | datapump | copy
# LOCAL_IMAGE=gvenzl/oracle-free:23-slim   # override the local DB image
# SQLCL_VERSION=latest                     # pin SQLcl, e.g. 23.4.0.023.2321
